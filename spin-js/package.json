{
  "name": "football-js",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.mjs && mkdirp dist && j2w -i build/bundle.js --initLocation http://football-js.localhost -o dist/football-js.wasm",
    "build:debug": "node build.mjs && mkdirp dist && j2w -d -i build/bundle.js --initLocation http://football-js.localhost -o dist/football-js.wasm",
    "start:node": "node container/src/main.js",
    "start:bun": "bun container/src/main.js",
    "start:deno": "deno run --allow-net --allow-env container/src/main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "mkdirp": "^3.0.1"
  },
  "dependencies": {
    "@spinframework/build-tools": "^2.1.0",
    "@spinframework/spin-postgres": "^2.0.0",
    "@spinframework/spin-variables": "^1.0.1",
    "@spinframework/wasi-http-proxy": "^2.0.0",
    "itty-router": "^5.0.18",
    "postgres": "^3.4.9"
  }
}
